# PostgreSQL (соответствует docker-compose: consumption_postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgrespassword
DB_NAME=consumption_db

# Redis (соответствует docker-compose: consumption_redis, пароль redispassword)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# MinIO (соответствует docker-compose: consumption_minio)
MINIO_HOST=127.0.0.1
MINIO_PORT=9000
MINIO_USER=minioadmin
MINIO_PASS=minioadmin

# Порт приложения (8000 — не конфликтует с 8080 swagger-editor, 8081 adminer)
# JWT и ServicePort задаются в config.toml
